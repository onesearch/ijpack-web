# Public origin of the site (canonical URL, Open Graph, robots.txt, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://www.example.co.kr

# Quote form → email via Resend (https://resend.com). Without these, /api/quote answers 503
# and the form asks visitors to call instead.
RESEND_API_KEY=
# One or more inboxes, comma-separated
QUOTE_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "IJPAK 홈페이지 <noreply@example.co.kr>"
QUOTE_FROM_EMAIL=
